# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Required: your bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Optional: enables real Sarvam Doc-AI OCR. If unset or unreachable, the bot
# falls back to a deterministic sample so the demo still runs offline.
SARVAM_API_KEY=

# Optional: public HTTPS URL of the liveness Mini App (Telegram Web App).
# e.g. run:  cloudflared tunnel --url http://localhost:8000
# then set this to the tunnel URL serving kyc_bot/webapp/liveness.html
WEBAPP_URL=
