# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Required: your bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Preferred for hackathon: Bedrock API key (boto3 picks this up automatically)
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key

# Optional alternative: traditional IAM access keys (not needed if bearer token is set)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_REGION=ap-south-1

# Amazon Nova — use the APAC inference profile ID in ap-south-1
# (plain amazon.nova-*-v1:0 often fails with on-demand ValidationException)
# Alternatives: apac.amazon.nova-lite-v1:0 | apac.amazon.nova-micro-v1:0
BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0
BEDROCK_MAX_TOKENS=512

# Sarvam (STT / Doc-AI). Optional for offline demo.
SARVAM_API_KEY=

# OCR provider for census_app: "fake" (default, offline sample) or "sarvam"
# (attempts real Doc-AI with SARVAM_API_KEY, falls back to sample on any error).
DOC_PROVIDER=fake

TEMPORAL_HOST=localhost:7233
EVIDENCE_ROOT=evidence

# Optional: public HTTPS URL of the liveness Mini App (Telegram Web App).
# e.g. run:  cloudflared tunnel --url http://localhost:8000
# then set this to the tunnel URL serving kyc_bot/webapp/liveness.html
WEBAPP_URL=

# Optional: Kognition liveness (offline stub if empty / KOGNITION_OFFLINE=true)
KOGNITION_API_KEY=
KOGNITION_OFFLINE=true
