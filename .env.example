# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Required: your bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Optional: Sarvam API key (Doc-AI). Auth-verified; the digitization job is async
# (upload/poll/parse), so it is not wired for the live demo — see DOC_PROVIDER.
SARVAM_API_KEY=

# OCR provider: "fake" (default, reliable, offline sample) or "sarvam" (attempts
# the real Doc-AI job with SARVAM_API_KEY, falling back to the sample on any error).
DOC_PROVIDER=fake

# Optional: public HTTPS URL of the liveness Mini App (Telegram Web App).
# e.g. run:  cloudflared tunnel --url http://localhost:8000
# then set this to the tunnel URL serving kyc_bot/webapp/liveness.html
WEBAPP_URL=
